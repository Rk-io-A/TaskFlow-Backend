# Docker Compose variables. Copy this file to .env and replace every placeholder.
TASKFLOW_POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
TASKFLOW_JWT_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
TASKFLOW_DEMO_ADMIN_EMAIL=
TASKFLOW_DEMO_ADMIN_PASSWORD=

# Direct ASP.NET Core configuration (for dotnet run outside Docker).
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=taskflow;Username=postgres;Password=REPLACE_WITH_LOCAL_PASSWORD
ConnectionStrings__Redis=localhost:6379
Jwt__Key=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
Jwt__Issuer=TaskFlow
Jwt__Audience=TaskFlowApp
DemoAdmin__Email=
DemoAdmin__Password=
